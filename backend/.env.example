# Server
PORT=8081
NODE_ENV=development

# Database (MySQL / MariaDB on Hostinger)
DATABASE_URL="mysql://user:password@localhost:3306/bigbisort"

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Twilio (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# CORS
CORS_ORIGINS=http://localhost:4200,https://darkorchid-walrus-237588.hostingersite.com
BASE_PATH=/bigbisort-imp-exp
MAIL_ENQUIRY_RECIPIENT=
MAIL_LOGO_URL=

# Only needed for `prisma migrate dev`; not used at runtime.
SHADOW_DATABASE_URL="mysql://user:password@localhost:3306/bigbisort_shadow"
